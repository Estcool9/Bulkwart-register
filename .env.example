APP_NAME=Mail Signup
PUBLIC_BASE_URL=https://signup.example.net
ADMIN_CONSOLE_URL=https://mail.example.net/admin
DEFAULT_APPROVAL_MODE=manual
DB_PATH=/data/requests.sqlite3

# Network binding. Keep the service private; allow only the reverse proxy.
APP_BIND=127.0.0.1
APP_PORT=8088
# Exact trusted reverse-proxy IP(s), comma-separated. Do not use * on a public listener.
FORWARDED_ALLOW_IPS=127.0.0.1

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=REPLACE_WITH_A_NEW_FERNET_KEY
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN

# Stalwart JMAP administrator account
STALWART_URL=https://mail.example.net
STALWART_ADMIN_USER=admin@example.net
STALWART_ADMIN_PASSWORD=REPLACE_WITH_STALWART_ADMIN_PASSWORD
# JSON object: permitted email domain -> its Stalwart domain ID
STALWART_DOMAINS_JSON={"example.net":"REPLACE_WITH_STALWART_DOMAIN_ID"}

# Optional administrator email notifications. Leave SMTP_HOST empty to disable.
ADMIN_NOTIFICATION_EMAIL=admin@example.net
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
